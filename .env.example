# ------------------------------------------------------------------ server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Booking links in emails point here (the frontend serves /booking/:token;
# the API also serves a fallback page at http://localhost:4000/booking/:token)
PUBLIC_BOOKING_BASE_URL=http://localhost:5173/booking

# ------------------------------------------------------------------ datastores
# docker compose overrides these with the service hostnames
MONGO_URI=mongodb://localhost:27017/airorecruit
REDIS_URL=redis://localhost:6379
# Alternative for hosted services (MongoDB Atlas / Redis Cloud): leave MONGO_URI / REDIS_URL empty and set
# DATABASE_URL=cluster0.xxxx.mongodb.net      (or a full mongodb+srv:// URI)
# DATABASE_USERNAME=  DATABASE_PASSWORD=  DATABASE_NAME=airorecruit
# REDIS_HOST=redis-12345.c1.cloud.redislabs.com  REDIS_PORT=12345  REDIS_USERNAME=default  REDIS_PASSWORD=  REDIS_TLS=false

# ------------------------------------------------------------------ LLM
# anthropic (default when a key is set) | openai (OpenAI or any OpenAI-compatible API, e.g. Gemini) | mock
# Leave LLM_API_KEY empty to run the whole app with the deterministic offline mock agent.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional: OpenAI-compatible base URL, e.g. https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# Defaults: anthropic → claude-opus-5-5 (agent/drafting) + claude-haiku-5-5 (scoring/classification)
#           openai    → gpt-4.1 + gpt-4.1-mini
LLM_MODEL_AGENT=
LLM_MODEL_FAST=
AGENT_MAX_ITERATIONS=6
# Per-job LLM budget in USD. Above it the chat agent pauses and scoring/classification fall back to heuristics.
JOB_BUDGET_USD=5
# Optional per-model prices (USD per 1M tokens), merged over the built-in table:
# PRICE_TABLE_JSON={"my-model":{"input":1,"output":4}}
PRICE_TABLE_JSON=

# ------------------------------------------------------------------ web sourcing (Serper.dev)
# Without a key, web search is skipped with a clear message and CSV upload still works.
SERPER_API_KEY=
SERPER_MAX_RESULTS=20

# ------------------------------------------------------------------ email
# Leave SMTP_HOST empty to auto-create an Ethereal test inbox (every send gets a preview URL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Maya from AiroRecruit <talent@airorecruit.dev>"

# ------------------------------------------------------------------ outreach
# Default per-campaign daily cap (editable per campaign on the preview card)
DAILY_SEND_LIMIT=50
# Length of one sequence "day" in ms. 86400000 = real days.
# For a demo, 60000 makes "Day 3" follow-ups fire after 3 minutes (and the daily limit resets every minute).
OUTREACH_DAY_MS=86400000

# Run the BullMQ workers inside the API process (local dev without a second terminal)
RUN_WORKERS_IN_API=false

# ------------------------------------------------------------------ talent rediscovery (vector search)
# Qdrant cluster (optional). Without it, vectors live in MongoDB (fine for tens of thousands of candidates).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=airorecruit_candidates
# local = on-device embeddings (all-MiniLM-L6-v2, downloaded once into ./.cache/models); off = disable
EMBEDDINGS=local
TALENT_MIN_SIMILARITY=0.5
# Standard provider key names are also accepted (auto-detected in this order when LLM_API_KEY is empty):
# ANTHROPIC_API_KEY=  OPENAI_API_KEY=  GEMINI_API_KEY=  GROQ_API_KEY=
# LLM_MAX_RPM=12   (client-side pacing; defaults to 12 for Gemini free tier)
