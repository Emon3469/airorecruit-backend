    { "text": "who won the football match yesterday?", "expect": "block", "rail": "off_topic" },
    { "text": "what's the bitcoin price right now", "expect": "block", "rail": "off_topic" },
    { "text": "give me a good pasta recipe", "expect": "block", "rail": "off_topic" },
