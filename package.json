{
  "name": "airorecruit-backend",
  "version": "1.0.0",
  "description": "AiroRecruit - chat-first AI recruiting co-worker (API + BullMQ workers)",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:all": "cross-env RUN_WORKERS_IN_API=true tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "eval:replies": "tsx scripts/eval-replies.ts",
    "check:connections": "tsx scripts/check-connections.ts",
    "eval": "cross-env NODE_ENV=test LOG_LEVEL=silent tsx evals/run.ts",
    "eval:baseline": "cross-env NODE_ENV=test LOG_LEVEL=silent tsx evals/run.ts --update-baseline",
    "eval:promptfoo": "cross-env PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 PROMPTFOO_CONFIG_DIR=./.promptfoo NODE_ENV=test node node_modules/promptfoo/dist/src/main.js eval -c evals/promptfoo/promptfooconfig.yaml --no-cache --no-progress-bar -o evals/results/promptfoo-latest.json",
    "eval:promptfoo:view": "cross-env PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_CONFIG_DIR=./.promptfoo node node_modules/promptfoo/dist/src/main.js view",
    "llm:smoke": "cross-env NODE_ENV=test tsx scripts/llm-smoke.ts",
    "talent:smoke": "cross-env NODE_ENV=test tsx scripts/talent-smoke.ts",
    "serper:smoke": "cross-env NODE_ENV=test tsx scripts/serper-smoke.ts",
    "eval:offline": "cross-env LLM_PROVIDER=mock NODE_ENV=test LOG_LEVEL=silent tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@huggingface/transformers": "3.7.0",
    "@qdrant/js-client-rest": "1.15.1",
    "bullmq": "^5.56.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "openai": "^6.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "promptfoo": "0.120.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
